{
  "rewrites": [{ "source": "/", "destination": "/final_frontend.html" }],
  "headers": [
    { "source": "/final_frontend.html", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
